# Auto detect text files and perform LF normalization
* text=auto

# 静态资源: 二进制文件, 不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.svg binary
*.ico binary
*.mp4 binary
*.webm binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# 文本文件统一 LF
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
